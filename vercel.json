{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd apps/axon-web && npm ci",
  "buildCommand": "cd apps/axon-web && npm run build:vercel",
  "outputDirectory": "apps/axon-web/dist",
  "rewrites": [
    { "source": "/connect", "destination": "/index.html" },
    { "source": "/catalogs", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/catalog/:catalogId/:schemaName/:tableName", "destination": "/index.html" },
    { "source": "/saved/:savedId", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    }
  ]
}
